  "compatibility": {
    "minimum": "14.360",
    "verified": "14.368"
  },
  "authors": [
    {
      "name": "ynsta",
      "url": "https://github.com/ynsta"
    }
  ],
  "license": "LICENSE",
  "url": "https://github.com/ynsta/pp-dice",
  "manifest": "https://github.com/ynsta/pp-dice/releases/latest/download/module.json",
  "download": "https://github.com/ynsta/pp-dice/releases/latest/download/module.zip",
  "readme": "https://github.com/ynsta/pp-dice/blob/main/README.md",
  "changelog": "https://github.com/ynsta/pp-dice/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/ynsta/pp-dice/issues",
  "esmodules": ["main.js"],
  "styles": ["styles/pp-dice.css"],
